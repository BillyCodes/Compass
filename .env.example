# Copy to .env and fill in. Never commit .env.
COMPASS_SECRET_KEY=replace-with-a-long-random-string
COMPASS_DEBUG=1
COMPASS_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use local SQLite (fastest setup).
# Set to use the team PostgreSQL database:
# DATABASE_URL=postgres://compass:compass@localhost:5432/compass
