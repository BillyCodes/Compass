# Compose automatically reads a root .env. Django currently reads only exported
# shell variables; it does not automatically load .env. See docs/development.md.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Required when debug is disabled; use a long randomly generated value.
# DJANGO_SECRET_KEY=replace-with-your-own-secret
# Database settings are deferred until the account-model agreement.

# Local PostgreSQL container. Copy this file to .env only if .env does not exist.
# Choose a local-only password before starting Compose; never commit .env.
POSTGRES_DB=compass
POSTGRES_USER=compass
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
