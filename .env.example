# Compose and Django read root .env. Exported shell values take precedence.
# See docs/development.md; never commit actual credentials.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Required when debug is disabled; use a long randomly generated value.
# DJANGO_SECRET_KEY=replace-with-your-own-secret
# Django uses the custom accounts.Account model with email login.

# Local PostgreSQL container. Copy this file to .env only if .env does not exist.
# Choose a local-only password before starting Compose; never commit .env.
POSTGRES_DB=compass
POSTGRES_USER=compass
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Host-run Django uses loopback; use db only if Django later runs in Compose.
POSTGRES_HOST=127.0.0.1
